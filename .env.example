# ============================================
# daoyi-cloud-rs 环境变量配置示例
# 复制为 .env 文件并根据环境修改
# ============================================

# JWT 密钥（必填，生产环境请使用强随机字符串）
APP_AUTH_JWT_SECRET=your-256-bit-secret-here-change-me

# 数据库连接信息
APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=3306
APP_DATABASE_USER=root
APP_DATABASE_PASSWORD=your_database_password

# 配置文件路径（可选，默认 resources/application-{app_name}.yaml）
# APP_CONFIG_PATH=/etc/daoyi-cloud/config.yaml

# 日志级别（可选，默认 info）
RUST_LOG=info

# 日志格式（可选：text/json，默认 text）
# RUST_LOG_FORMAT=json

# 限流配置（可选）
# RATE_LIMIT_MAX=1000
# RATE_LIMIT_WINDOW_SECS=60
